table DimAccount
	lineageTag: 66299ff4-53cf-443b-8967-83be164edd9e

	measure DoublonCheck =
			
			COUNTROWS(
			    FILTER(
			        DimAccount,
			        CALCULATE(COUNTROWS(DimAccount), ALLEXCEPT(DimAccount, DimAccount[AccountNumber])) > 1
			    )
			)
		formatString: 0
		lineageTag: 76c113cb-3f9c-4169-bd90-4d23c9cbaf8e

