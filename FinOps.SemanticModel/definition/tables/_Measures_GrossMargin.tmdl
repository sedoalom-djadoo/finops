table _Measures_GrossMargin
	lineageTag: 522ee86c-02a7-40f3-85dd-7b662d8625eb

	/// Dynamic title for the site chart, so the allocation and the data gap stay visible.
	measure 'Allocated Gross Margin by Site Title' = ```
			"Gross margin by site, allocated by revenue share (cost tagging coverage: "
			    & FORMAT ( CALCULATE ( [Class Tagging Coverage %], ALL ( DimSite ) ), "0%" ) & ")"
			```
		lineageTag: 5ca75e93-6704-4e2f-b474-0065a6a7bb18

	/// Site billing revenue minus the direct costs actually tagged to that site. Only meaningful when Class Tagging Coverage % is high; today it overstates margins.
	measure 'Measured Gross Margin by Site' = ```
			[Total Revenue]
			    - CALCULATE ( [Direct Costs], TREATAS ( VALUES ( DimSite[SiteCode] ), FactTransactions[SiteCode] ) )
			```
		lineageTag: 33a46063-b789-483d-843b-9b624f6cc38b

	/// Share of direct costs whose QuickBooks Class identifies a site. Site-level margins can be measured instead of allocated once this is close to 100 %.
	measure 'Class Tagging Coverage %' = ```
			DIVIDE (
			    CALCULATE ( [Direct Costs], NOT ISBLANK ( FactTransactions[SiteCode] ) ),
			    [Direct Costs]
			)
			```
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: c93067a6-8e51-46d5-b0e7-a20d9bde6018

	/// Company gross margin from the accounting system: QuickBooks revenue (account 40001) minus direct costs, net of the current-year SR&ED credit.
	measure 'Gross Margin (Company)' = ```
			[Revenue QB] - [Direct Costs] - [SRED Credit]
			```
		lineageTag: 8c6ea768-5e79-4d07-acf7-e582b1c1b392

	measure 'Direct Costs' =
			
			CALCULATE(
			    SUM(FactTransactions[Amount]),
			    DimAccount[IsDirectCost] = TRUE()
			)
		lineageTag: 6f458f7a-43c5-4ec0-87c4-13c323fca758

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'SRED Credit' =
			
			CALCULATE(
			    SUM(FactTransactions[Amount]),
			    DimAccount[IsSREDCredit] = TRUE()
			)
		lineageTag: a9f253da-55cf-497e-9597-29c9eee54a43

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Company gross margin; when a site is selected, the site's allocated share (see Allocated Gross Margin by Site).
	measure 'Gross Margin' = ```
			IF ( ISFILTERED ( DimSite ), [Allocated Gross Margin by Site], [Gross Margin (Company)] )
			```
		lineageTag: 2342dc5b-06af-4b27-8fe6-a149f958b333

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Gross margin / QuickBooks revenue. Not site-specific: with revenue-share allocation every site has the same rate by construction.
	measure 'Gross Margin %' = ```
			DIVIDE ( [Gross Margin (Company)], [Revenue QB], 0 )
			```
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 0dd3ec98-fc08-4a35-87d3-5fc5f2d0221e

	measure 'Gross Margin Prior Year' =
			
			CALCULATE(
			    [Gross Margin],
			    SAMEPERIODLASTYEAR ( CALCULATETABLE ( VALUES ( DimDate[Date] ), DimDate[IsBeforeDataCutoff] = TRUE () ) )
			)
		lineageTag: 59a0101a-52d3-41bf-a1c6-6fc70728c846

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gross Margin YOY Growth %' =
			
			IF(
			    ISBLANK([Gross Margin Prior Year]),
			    BLANK(),
			    DIVIDE([Gross Margin] - [Gross Margin Prior Year], [Gross Margin Prior Year])
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 333e8543-829b-4642-a9b6-fef2060d6590

	measure 'Gross Margin YTD' =
			
			TOTALYTD(
			    [Gross Margin],
			    DimDate[Date],
			    "08-31"
			)
		lineageTag: 9fb225e1-b2eb-4f30-8680-c4d0b363c3f9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gross Margin Prior Year YTD' =
			
			TOTALYTD(
			    [Gross Margin Prior Year],
			    DimDate[Date],
			    "08-31"
			)
		lineageTag: 6cf2a6f5-a4d8-46ca-80a1-29971de2708a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'SRED Credit Annual' =
			
			CALCULATE(
			    [SRED Credit],
			    ALLEXCEPT(DimDate, DimDate[FiscalYear])
			)
		lineageTag: 16c83be2-3236-4742-bcc1-7319dbc81bd7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Direct Cost Composition %' =
			
			VAR _catCost = CALCULATE(
			    SUM(FactTransactions[Amount]),
			    DimAccount[IsDirectCost] = TRUE()
			)
			VAR _totalDirectCost = CALCULATE(
			    SUM(FactTransactions[Amount]),
			    ALLSELECTED(DimAccount),
			    DimAccount[IsDirectCost] = TRUE()
			)
			RETURN
			DIVIDE(_catCost, _totalDirectCost, 0)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: e46691fa-a0f5-41c8-9c96-af35ff3ce608

	/// ALLOCATION, not a measurement: company gross margin split by each site's share of billing revenue. QuickBooks does not tag most costs with a site (see Class Tagging Coverage %).
	measure 'Allocated Gross Margin by Site' = ```
			VAR SiteBillingShare =
			    DIVIDE ( [Total Revenue], CALCULATE ( [Total Revenue], ALL ( DimSite ) ) )
			RETURN
			    CALCULATE ( [Gross Margin (Company)], ALL ( DimSite ) ) * SiteBillingShare
			```
		lineageTag: 64521a1d-e0cd-4b2b-880d-776f43d59f73

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gross Margin YOY Variance' =
			
			IF(
			    ISBLANK([Gross Margin Prior Year]),
			    "No prior year data",
			    VAR _growth = [Gross Margin YOY Growth %]
			    VAR _delta = [Gross Margin] - [Gross Margin Prior Year]
			    VAR _arrow = IF(_growth >= 0, "▲ +", "▼ ")
			    VAR _pct = FORMAT(ABS(_growth), "0.0%")
			    VAR _sign = IF(_delta >= 0, "+", "-")
			    VAR _abs = _sign & FORMAT(ABS(_delta) / 1000000, "0.00") & "M"
			    RETURN _arrow & _pct & " | " & _abs & " vs PY"
			)
		lineageTag: fb65a8be-b902-47bc-b5b1-16618543bc47

	measure 'Gross Margin % Prior Year' =
			
			CALCULATE(
			    [Gross Margin %],
			    SAMEPERIODLASTYEAR ( CALCULATETABLE ( VALUES ( DimDate[Date] ), DimDate[IsBeforeDataCutoff] = TRUE () ) )
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: f9517945-a43d-4be6-a597-ca96c2145f1a

	measure 'Direct Costs Prior Year' =
			
			CALCULATE(
			    [Direct Costs],
			    SAMEPERIODLASTYEAR ( CALCULATETABLE ( VALUES ( DimDate[Date] ), DimDate[IsBeforeDataCutoff] = TRUE () ) )
			)
		lineageTag: b5f0c247-3b1f-4876-ae93-5245c0159ec8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'SRED Credit Prior Year' =
			
			CALCULATE(
			    [SRED Credit],
			    SAMEPERIODLASTYEAR ( CALCULATETABLE ( VALUES ( DimDate[Date] ), DimDate[IsBeforeDataCutoff] = TRUE () ) )
			)
		lineageTag: 624d62ab-7ac3-4d1f-b237-a70385cc4ad6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gross Margin % Prior Year Variance' =
			
			IF(
			    ISBLANK([Gross Margin % Prior Year]),
			    "No prior year data",
			    VAR _current = [Gross Margin %]
			    VAR _py = [Gross Margin % Prior Year]
			    VAR _delta = _current - _py
			    VAR _arrow = IF(_delta >= 0, "▲ +", "▼ ")
			    VAR _pts = FORMAT(ABS(_delta) * 100, "0.0") & " pts"
			    VAR _pct = FORMAT(ABS(_delta / _py), "0.0%")
			    RETURN _arrow & _pct & " | " & _pts & " vs PY"
			)
		lineageTag: 6e90d03b-ae9e-44c7-810a-f5462997459c

	measure 'Direct Costs Prior Year Variance' =
			
			IF(
			    ISBLANK([Direct Costs Prior Year]),
			    "No prior year data",
			    VAR _growth = [Direct Costs YOY Growth %]
			    VAR _delta = [Direct Costs] - [Direct Costs Prior Year]
			    VAR _arrow = IF(_growth >= 0, "▲ +", "▼ ")
			    VAR _pct = FORMAT(ABS(_growth), "0.0%")
			    VAR _sign = IF(_delta >= 0, "+", "-")
			    VAR _abs = _sign & FORMAT(ABS(_delta) / 1000000, "0.00") & "M"
			    RETURN _arrow & _pct & " | " & _abs & " vs PY"
			)
		lineageTag: de7a9290-fc1f-4517-9c77-3f0c219fc6b2

	measure 'SRED Credit Prior Year Variance' =
			
			IF(
			    ISBLANK([SRED Credit Prior Year]),
			    "No prior year data",
			    VAR _current = [SRED Credit]
			    VAR _py = [SRED Credit Prior Year]
			    VAR _delta = _current - _py
			    VAR _growth = DIVIDE(_delta, ABS(_py))
			    VAR _arrow = IF(_delta >= 0, "▼ ", "▲ +")
			    VAR _pct = FORMAT(ABS(_growth), "0.0%")
			    VAR _sign = IF(_delta >= 0, "-", "+")
			    VAR _abs = _sign & FORMAT(ABS(_delta) / 1000000, "0.00") & "M"
			    RETURN _arrow & _pct & " | " & _abs & " vs PY"
			)
		lineageTag: 49a502b9-44f9-4ec2-80a4-9a592617769c

	measure 'Direct Costs YOY Growth %' =
			
			IF(
			    ISBLANK([Direct Costs Prior Year]),
			    BLANK(),
			    DIVIDE([Direct Costs] - [Direct Costs Prior Year], [Direct Costs Prior Year])
			)
		lineageTag: 67e1e72a-f0e8-4011-b8f0-a40b5dadc94a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'SRED Credit YOY Growth %' =
			
			IF(
			    ISBLANK([SRED Credit Prior Year]),
			    BLANK(),
			    DIVIDE([SRED Credit] - [SRED Credit Prior Year], ABS([SRED Credit Prior Year]))
			)
		lineageTag: 6a2ec428-4128-4305-812f-d572fa093ba2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Allocated Gross Margin by Site Prior Year' =
			
			CALCULATE(
			    [Allocated Gross Margin by Site],
			    SAMEPERIODLASTYEAR ( CALCULATETABLE ( VALUES ( DimDate[Date] ), DimDate[IsBeforeDataCutoff] = TRUE () ) )
			)
		lineageTag: 3c03072d-a4a9-44c5-b392-0dc8fcda2b4f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Direct Cost Composition % Prior Year' =
			
			VAR _catCost = CALCULATE(
			    SUM(FactTransactions[Amount]),
			    DimAccount[IsDirectCost] = TRUE(),
			    SAMEPERIODLASTYEAR ( CALCULATETABLE ( VALUES ( DimDate[Date] ), DimDate[IsBeforeDataCutoff] = TRUE () ) )
			)
			VAR _totalDirectCost = CALCULATE(
			    SUM(FactTransactions[Amount]),
			    ALLSELECTED(DimAccount),
			    DimAccount[IsDirectCost] = TRUE(),
			    SAMEPERIODLASTYEAR ( CALCULATETABLE ( VALUES ( DimDate[Date] ), DimDate[IsBeforeDataCutoff] = TRUE () ) )
			)
			RETURN
			IF(ISBLANK(_totalDirectCost), BLANK(), DIVIDE(_catCost, _totalDirectCost))
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: dff0af79-c8e8-47df-9917-2010d76c59ce

	measure 'SRED Credit Display' =
			
			[SRED Credit] * -1
		lineageTag: c1e3b940-b283-42a7-81c0-c5a3e563cc13

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'SRED Credit Annual Display' =
			
			CALCULATE(
			    [SRED Credit Display],
			    ALLEXCEPT(DimDate, DimDate[FiscalYear])
			)
		lineageTag: 0121d1e7-84c5-4b21-bce6-7d12669c8d6b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Column1
		lineageTag: 1cea4fb0-dff6-465b-ac52-b20eff812006
