	partition DimSponsorMapping = m
		mode: import
		source = ```
				let
				    // Finance-maintained mapping: every billing-file spelling and QB customer name -> one sponsor
				    Source = Excel.Workbook(File.Contents(DataFolder & "DimSponsorMapping.xlsx"), null, true),
				    Sheet = Source{[Item="DimSponsorMapping",Kind="Sheet"]}[Data],
				    SkipTitleRows = Table.Skip(Sheet, 3),
				    PromoteHeaders = Table.PromoteHeaders(SkipTitleRows, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(PromoteHeaders, {
				        {"SponsorRaw_Billing", type text}, {"SponsorRaw_QB", type text}, {"SponsorNameNormalized", type text},
				        {"IncludeInRevenue", type text}, {"Notes", type text}, {"Status", type text}
				    })
				in
				    Typed
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

