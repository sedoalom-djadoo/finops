		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition FactBalanceSheet = m
		mode: import
		source = ```
				let
				    Source = Excel.Workbook(File.Contents(DataFolder & "Balance_Sheet_by_FY.xlsx"), null, true),
				    SheetMapping = #table(
				        {"SheetName", "AsOfDate", "IsPartialYear"},
				        {
				            {"2023", #date(2023, 8, 31), false},
				            {"2024", #date(2024, 8, 31), false},
				            {"2025", #date(2025, 8, 31), false},
				            {"2026", #date(2026, 7, 9),  true}
				        }
				    ),
				    FilteredSheets = Table.SelectRows(Source, each List.Contains({"2023","2024","2025","2026"}, [Item])),
				    JoinedWithMapping = Table.NestedJoin(FilteredSheets, {"Item"}, SheetMapping, {"SheetName"}, "MappingData", JoinKind.Inner),
				    ProcessSheet = Table.AddColumn(JoinedWithMapping, "ProcessedData", each
				        let
				            RawTable = Table.Buffer([Data]),
				            SkippedHeader = Table.Skip(RawTable, 5),
				            // account rows start with a digit; QB prints "Profit for the year" without an account number,
				            // so it is mapped to the synthetic account 99999 here instead of being hard-coded
				            KeepRows = Table.SelectRows(SkippedHeader, each
				                [Column1] <> null and Text.Length(Text.From([Column1])) > 0 and
				                (List.Contains({"0".."9"}, Text.Start(Text.From([Column1]), 1)) or Text.From([Column1]) = "Profit for the year")
				            ),
				            AddAccountNumber = Table.AddColumn(KeepRows, "AccountNumber", each
				                if Text.From([Column1]) = "Profit for the year" then "99999" else Text.BeforeDelimiter(Text.From([Column1]), " ")),
				            AddAccountName = Table.AddColumn(AddAccountNumber, "AccountName", each
				                if Text.From([Column1]) = "Profit for the year" then "Profit for the year" else Text.Trim(Text.AfterDelimiter(Text.From([Column1]), " "))),
				            SelectFinal = Table.SelectColumns(AddAccountName, {"AccountNumber", "AccountName", "Column2"})
				        in
				            SelectFinal
				    ),
				    ExpandProcessed = Table.ExpandTableColumn(ProcessSheet, "ProcessedData", {"AccountNumber", "AccountName", "Column2"}, {"AccountNumber", "AccountName", "Balance"}),
				    ExpandMapping = Table.ExpandTableColumn(ExpandProcessed, "MappingData", {"AsOfDate", "IsPartialYear"}, {"AsOfDate", "IsPartialYear"}),
				    SelectColumns = Table.SelectColumns(ExpandMapping, {"AccountNumber", "AccountName", "AsOfDate", "IsPartialYear", "Balance"}),
				    ChangedTypes = Table.TransformColumnTypes(SelectColumns, {
				        {"AccountNumber", type text}, {"AccountName", type text}, {"AsOfDate", type date},
				        {"IsPartialYear", type logical}, {"Balance", type number}
				    })
				in
				    ChangedTypes
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

