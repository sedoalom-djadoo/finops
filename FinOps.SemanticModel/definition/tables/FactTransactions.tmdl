	partition FactTransactions = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DataFolder & "General_Ledger_Transaction_Detail.xlsx"), false, true),
				    Sheet = Source{[Item="Sheet1",Kind="Sheet"]}[Data],
				    BufferedSheet = Table.Buffer(Sheet),
				
				    // Tag account header rows only (non-null Column1, not a Total row, Column2 is null)
				    AddAccountRaw = Table.AddColumn(BufferedSheet, "AccountRaw", each
				        if [Column1] <> null
				           and not Text.StartsWith(Text.From([Column1] ?? ""), "Total")
				           and [Column2] = null
				        then Text.From([Column1])
				        else null
				    , type text),
				
				    // FillDown to propagate account name to all transaction rows below
				    FilledDown = Table.FillDown(AddAccountRaw, {"AccountRaw"}),
				
				    // Keep only transaction rows: Column1 = null, Column2 = date (not header)
				    FilterTransactions = Table.SelectRows(FilledDown, each
				        [Column1] = null and
				        [Column2] <> null and
				        [Column2] <> "Transaction date"
				    ),
				
				    // Extract AccountNumber (digits before first space in AccountRaw)
				    AddAccountNumber = Table.AddColumn(FilterTransactions, "AccountNumber", each
				        Text.BeforeDelimiter([AccountRaw] ?? "", " ")
				    , type text),
				
				    // Select and rename columns
				    SelectColumns = Table.SelectColumns(AddAccountNumber, {
				        "AccountNumber", "AccountRaw", "Column2", "Column3", "Column4",
				        "Column5", "Column6", "Column7", "Column8", "Column9"
				    }),
				    RenameColumns = Table.RenameColumns(SelectColumns, {
				        {"Column2", "TransactionDate"},
				        {"Column3", "TransactionType"},
				        {"Column4", "ReferenceNumber"},
				        {"Column5", "Name"},
				        {"Column6", "ClassFullName"},
				        {"Column7", "Description"},
				        {"Column8", "SplitAccount"},
				        {"Column9", "Amount"}
				    }),
				
				    // Type conversions
				    TypedTable = Table.TransformColumnTypes(RenameColumns, {
				        {"AccountNumber", type text},
				        {"AccountRaw", type text},
				        {"TransactionDate", type date},
				        {"TransactionType", type text},
				        {"ReferenceNumber", type text},
				        {"Name", type text},
				        {"ClassFullName", type text},
				        {"Description", type text},
				        {"SplitAccount", type text},
				        {"Amount", type number}
				    }),
				
				    // DateKey for DimDate relationship
				    AddDateKey = Table.AddColumn(TypedTable, "DateKey", each
				        Date.Year([TransactionDate]) * 10000 +
				        Date.Month([TransactionDate]) * 100 +
				        Date.Day([TransactionDate])
				    , Int64.Type),
				
				    // YearMonthKey for DimExchangeRate relationship
				    AddYearMonthKey = Table.AddColumn(AddDateKey, "YearMonthKey", each
				        Date.Year([TransactionDate]) * 100 + Date.Month([TransactionDate])
				    , Int64.Type),
				
				    // SiteCode from the QuickBooks Class field (blank when the bookkeeper did not tag a site)
				    AddSiteCode = Table.AddColumn(AddYearMonthKey, "SiteCode", each
				        if [ClassFullName] = "Toronto" then "TOR"
				        else if [ClassFullName] = "Calgary" then "CAL"
				        else if [ClassFullName] = "Vancouver" then "VAN"
				        else null
				    , type text)
				in
				    AddSiteCode

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

