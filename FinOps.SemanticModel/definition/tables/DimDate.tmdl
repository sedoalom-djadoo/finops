	column FiscalMonthName =
			
			SWITCH(
			    DimDate[FiscalMonthNumber],
			    1, "Sep",
			    2, "Oct",
			    3, "Nov",
			    4, "Dec",
			    5, "Jan",
			    6, "Feb",
			    7, "Mar",
			    8, "Apr",
			    9, "May",
			    10, "Jun",
			    11, "Jul",
			    12, "Aug"
			)
		lineageTag: 578305a8-1905-4a3b-9d6f-577fe9275659
		summarizeBy: none
		sortByColumn: FiscalMonthNumber

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	/// TRUE up to the last transaction date in the general ledger. Prior-year measures shift only these dates, so a partial current year is compared with the same partial period last year.
	column IsBeforeDataCutoff = DimDate[Date] <= MAX ( FactTransactions[TransactionDate] )
		dataType: boolean
		lineageTag: f54ef2b9-64d1-4925-ab97-ca7db53a4f98
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition DimDate = m
		mode: import
		source = ```
				let
				    StartDate = #date(2022, 9, 1),
				    EndDate = #date(2027, 8, 31),
				
				    DateList = List.Dates(StartDate, Duration.Days(EndDate - StartDate) + 1, #duration(1, 0, 0, 0)),
				    DateTable = Table.FromList(DateList, Splitter.SplitByNothing(), {"Date"}),
				    ChangedType = Table.TransformColumnTypes(DateTable, {{"Date", type date}}),
				
				    // Calendar columns
				    AddYear = Table.AddColumn(ChangedType, "CalendarYear", each Date.Year([Date]), Int64.Type),
				    AddMonth = Table.AddColumn(AddYear, "CalendarMonthNumber", each Date.Month([Date]), Int64.Type),
				    AddMonthName = Table.AddColumn(AddMonth, "CalendarMonthName", each Date.ToText([Date], "MMMM"), type text),
				    AddQuarter = Table.AddColumn(AddMonthName, "CalendarQuarter", each "Q" & Text.From(Date.QuarterOfYear([Date])), type text),
				
				    // Fiscal year columns (Sep = Month 1, Aug = Month 12)
				    AddFiscalMonthNumber = Table.AddColumn(AddQuarter, "FiscalMonthNumber", each 
				        if Date.Month([Date]) >= 9 then Date.Month([Date]) - 8 
				        else Date.Month([Date]) + 4, Int64.Type),
				
				    AddFiscalYear = Table.AddColumn(AddFiscalMonthNumber, "FiscalYear", each 
				        if Date.Month([Date]) >= 9 then Date.Year([Date]) + 1 
				        else Date.Year([Date]), Int64.Type),
				
				    AddFiscalYearLabel = Table.AddColumn(AddFiscalYear, "FiscalYearLabel", each 
				        "FY" & Text.From([FiscalYear] - 1) & "-" & Text.From([FiscalYear]), type text),
				
				    AddFiscalQuarter = Table.AddColumn(AddFiscalYearLabel, "FiscalQuarter", each 
				        "Q" & Text.From(Number.RoundUp([FiscalMonthNumber] / 3, 0)), type text),
				
				    // Day of week
				    AddDayOfWeek = Table.AddColumn(AddFiscalQuarter, "DayOfWeek", each Date.DayOfWeekName([Date]), type text),
				    AddIsWeekend = Table.AddColumn(AddDayOfWeek, "IsWeekend", each Date.DayOfWeek([Date]) >= 5, type logical),
				
				    // Date key for relationships
				    AddDateKey = Table.AddColumn(AddIsWeekend, "DateKey", each Date.Year([Date]) * 10000 + Date.Month([Date]) * 100 + Date.Day([Date]), Int64.Type)
				
				in
				    AddDateKey
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

